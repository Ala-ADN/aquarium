# Public Firebase web-app configuration. Never put service-account keys here.
# Leave all values empty to run the aquarium with browser-only saving.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional Google Analytics measurementId from the Web app config (G-...).
# Tracking runs only in production builds. Leave empty to disable it.
VITE_FIREBASE_MEASUREMENT_ID=

# Public reCAPTCHA Enterprise site key registered with Firebase App Check.
VITE_FIREBASE_APP_CHECK_SITE_KEY=

# Local development only; NEVER enable for a production build.
VITE_FIREBASE_EMULATORS=false
